PORT=8787

# OPCIÓN 1: Google AI Studio (Recomendado para Gemma 4)
# Obtén gratis en: https://ai.google.dev
# 1. Ve a Google AI Studio
# 2. Crea un nuevo proyecto
# 3. Copia tu API key aquí
GOOGLE_API_KEY=your_google_api_key

# Modelo (por defecto: gemma-4-31b-it)
# Opciones: gemma-4-31b-it, gemma-4-27b-moe, gemma-4-2b-it
GOOGLE_MODEL=gemma-4-31b-it

# OPCIÓN 2: OpenRouter (Fallback gratuito)
# Obtén gratis en: https://openrouter.ai
# 1. Sign up
# 2. Copia tu API key
OPENROUTER_API_KEY=your_openrouter_api_key

# Modelo OpenRouter (por defecto: google/gemma-4-31b-it:free)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Opcional: desactiva llamadas a IA (útil para pruebas/CI deterministas)
# true  = solo reglas WCAG locales
# false = habilita proveedores IA configurados
DISABLE_LLM=false
